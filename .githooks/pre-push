#!/usr/bin/env sh
set -eu

echo "[cordon-hive pre-push] Running local CI gate (scripts/ci-local.ps1)..."

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/ci-local.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ci-local.ps1
else
    echo "[cordon-hive pre-push] ERROR: Neither pwsh nor powershell.exe was found on PATH." >&2
    exit 1
fi
