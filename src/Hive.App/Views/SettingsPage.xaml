<Page
    x:Class="Hive.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="4" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock
                Text="Settings"
                Style="{ThemeResource TitleTextBlockStyle}"
                AutomationProperties.Name="Settings Heading" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Account &amp; Session" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind MainVm.SignedInUserSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind MainVm.ScopeSummaryText, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <InfoBar
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="{x:Bind MainVm.MustChangePasswordBanner, Mode=OneWay}"
                        Title="Temporary Password Active"
                        Message="Please update your password using Change Password." />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="{x:Bind MainVm.SignInButtonLabel, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="SignInButton_Click"
                            AutomationProperties.Name="Sign In" />
                        <Button
                            Content="Sign Out"
                            IsEnabled="{x:Bind MainVm.CanSignOut, Mode=OneWay}"
                            Click="SignOutButton_Click"
                            AutomationProperties.Name="Sign Out" />
                        <Button
                            Content="Change Password"
                            IsEnabled="{x:Bind MainVm.IsSignedIn, Mode=OneWay}"
                            Click="ChangePasswordButton_Click"
                            AutomationProperties.Name="Change Password" />
                    </StackPanel>

                    <TextBlock
                        x:Name="AccountStatusText"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="LAN Server Connection" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Operates strictly on the internal forensic LAN using local bearer sessions (DPAPI-protected) or Windows Negotiate authentication."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <TextBox
                        x:Name="ServerUrlTextBox"
                        Header="Hive Server Base URL"
                        PlaceholderText="https://localhost:5001"
                        AutomationProperties.Name="Hive Server Base URL Input" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Apply &amp; Reconnect"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="ApplyAndReconnectButton_Click"
                            AutomationProperties.Name="Apply Server URL and Reconnect" />
                    </StackPanel>

                    <TextBlock
                        x:Name="SettingsStatusText"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Workstation Break-Glass Credential Escrow" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Write-only break-glass credential storage for your assigned workstations (encrypted server-side with AES-256-GCM). Saved passwords are never read back or displayed."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="EscrowWorkstationComboBox"
                            Grid.Column="0"
                            Header="Assigned Workstation"
                            PlaceholderText="Select an assigned workstation"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="EscrowWorkstationComboBox_SelectionChanged"
                            AutomationProperties.Name="Assigned Workstation Selector" />
                        <Button
                            x:Name="RefreshEscrowWorkstationsButton"
                            Grid.Column="1"
                            Content="Refresh"
                            VerticalAlignment="Bottom"
                            Click="RefreshEscrowWorkstationsButton_Click"
                            AutomationProperties.Name="Refresh Assigned Workstations" />
                    </Grid>

                    <TextBlock
                        x:Name="EscrowMetadataText"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <TextBox
                        x:Name="EscrowUsernameTextBox"
                        Header="Workstation Login Username"
                        PlaceholderText="e.g. .\examiner or DOMAIN\examiner"
                        AutomationProperties.Name="Workstation Login Username" />

                    <PasswordBox
                        x:Name="EscrowPasswordBox"
                        Header="Workstation Password"
                        PlaceholderText="Enter workstation login password"
                        AutomationProperties.Name="Workstation Escrow Password" />

                    <PasswordBox
                        x:Name="EscrowConfirmPasswordBox"
                        Header="Confirm Workstation Password"
                        PlaceholderText="Re-enter workstation login password"
                        AutomationProperties.Name="Confirm Workstation Escrow Password" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SaveEscrowButton"
                            Content="Save Break-Glass Credential"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="SaveEscrowButton_Click"
                            AutomationProperties.Name="Save Break-Glass Credential" />
                    </StackPanel>

                    <TextBlock
                        x:Name="EscrowStatusText"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="Client Execution Context" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="Execution Level: Unelevated (asInvoker). Administrative software deployment brokers run separately via signed local IPC permits (P5)."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
