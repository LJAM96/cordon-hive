<Page
    x:Class="Hive.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="4" MaxWidth="920" HorizontalAlignment="Left">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        Text="Updates &amp; Protection Lock"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        AutomationProperties.Name="Updates Heading" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock
                            Text="{x:Bind ViewModel.SignedInAccountSummary, Mode=OneWay}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LastRefreshedLocalText, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="Refresh"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh Protection Lock State" />
            </Grid>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
                Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.FeedbackTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
                AutomationProperties.Name="Updates Protection Lock Status Banner" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="{x:Bind ViewModel.ProtectedModeGlyph, Mode=OneWay}" FontSize="20" />
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="{x:Bind ViewModel.ProtectedModeHeadline, Mode=OneWay}"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                AutomationProperties.Name="Protected Forensic Work Mode Headline" />
                            <TextBlock
                                Text="{x:Bind ViewModel.IpcStatusMessage, Mode=OneWay}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Reason Code" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ReasonCode, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Locked By SID" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LockedBySid, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Updated (Local / UTC)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.UpdatedUtcDisplay, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Manual Protected Forensic Work Mode Control" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBox
                        Header="Reason Code"
                        Text="{x:Bind ViewModel.ReasonCodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="e.g. forensic_examination_active"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        AutomationProperties.Name="Protection Lock Reason Code" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            Content="Enable Protection Lock"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.EnableProtectionLockCommand}"
                            AutomationProperties.Name="Enable Protection Lock" />
                        <Button
                            Content="Disable Protection Lock"
                            Command="{x:Bind ViewModel.DisableProtectionLockCommand}"
                            AutomationProperties.Name="Disable Protection Lock" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Fail-Closed Deferred Update Policy"
                Message="{x:Bind ViewModel.FailClosedPolicySummary}"
                AutomationProperties.Name="Fail-Closed Deferred Update Policy Notice" />
        </StackPanel>
    </ScrollViewer>
</Page>
