<Page
    x:Class="Hive.App.Views.WorkstationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Hive.App.ViewModels">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                Text="Workstations"
                Style="{ThemeResource TitleTextBlockStyle}"
                AutomationProperties.Name="Workstations Heading" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.LastRefreshedLocalText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                PlaceholderText="Search hostname, asset number, or assigned user SID..."
                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="Search Workstations" />

            <ComboBox
                Grid.Column="1"
                SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                AutomationProperties.Name="Sort Workstations">
                <ComboBoxItem Content="Sort: Last Seen (Newest)" />
                <ComboBoxItem Content="Sort: Hostname (A-Z)" />
            </ComboBox>

            <Button
                Grid.Column="2"
                Content="Refresh"
                Command="{x:Bind ViewModel.LoadCommand}"
                AutomationProperties.Name="Refresh Workstations List" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.FilteredWorkstations, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedWorkstation, Mode=TwoWay}"
                AutomationProperties.Name="Workstations List">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkstationItemViewModel">
                        <Grid Padding="8,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Hostname}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        Text="{x:Bind SiteId}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind AssetNumberDisplay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind AssignedUserDisplay}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind LoadStatusText}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="2"
                                AutomationProperties.Name="{x:Bind ConnectivityAccessibilityName}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <FontIcon Glyph="{x:Bind ConnectivityGlyph}" FontSize="14" />
                                    <TextBlock
                                        Text="{x:Bind ConnectivityText}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind LastSeenLocalText}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Text="Asset &amp; User Allocation" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Select a workstation from the list to update its asset tag or assigned examiner SID."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <TextBox
                        Header="Asset Number"
                        PlaceholderText="e.g. DFU-WS-014"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        Text="{x:Bind ViewModel.EditAssetNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Asset Number Input" />

                    <TextBox
                        Header="Assigned User SID"
                        PlaceholderText="e.g. S-1-5-21-..."
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                        Text="{x:Bind ViewModel.EditAssignedUserSid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="Assigned User SID Input" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="Save Assignment"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.AssignAssetCommand}"
                            AutomationProperties.Name="Save Workstation Assignment" />

                        <Button
                            Content="View Detail &amp; Telemetry"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                            Click="ViewDetailButton_Click"
                            AutomationProperties.Name="View Workstation Detail and Telemetry" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind ViewModel.AssignmentFeedback, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
