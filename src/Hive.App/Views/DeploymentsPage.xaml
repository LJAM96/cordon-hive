<Page
    x:Class="Hive.App.Views.DeploymentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" Padding="4" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock
            Text="Deployments"
            Style="{ThemeResource TitleTextBlockStyle}"
            AutomationProperties.Name="Deployments Heading" />
        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Scheduled for Phase P5 (Safe Deployment)"
            Message="Supervisor target previews, signed immutable release rollouts, workload guard locks, and deployment state transitions will be orchestrated here." />
    </StackPanel>
</Page>
