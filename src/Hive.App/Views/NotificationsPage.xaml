<Page
    x:Class="Hive.App.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Hive.App.ViewModels">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="4">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock
                            Text="Notifications"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            AutomationProperties.Name="Notifications Heading" />
                        <Border
                            Padding="8,2"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.UnresolvedCount, Mode=OneWay}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold"
                                AutomationProperties.Name="Unresolved Notification Count" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock
                            Text="{x:Bind ViewModel.RoleScopeSummaryText, Mode=OneWay}"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LastSyncedLocalText, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.WidgetStatusText, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Content="Compose Notification"
                        Visibility="{x:Bind ViewModel.PublishSectionVisibility, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        Click="ComposeButton_Click"
                        AutomationProperties.Name="Compose Notification" />

                    <Button
                        Content="Toggle Taskbar Widget"
                        Click="ToggleWidgetButton_Click"
                        AutomationProperties.Name="Toggle Taskbar Widget" />

                    <Button
                        Content="Refresh"
                        Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.Name="Refresh Notifications" />
                </StackPanel>
            </Grid>

            <InfoBar
                IsOpen="{x:Bind ViewModel.IsFeedbackOpen, Mode=TwoWay}"
                Severity="{x:Bind ViewModel.FeedbackSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.FeedbackTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}"
                AutomationProperties.Name="Notifications Status Banner" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="My Notifications"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBlock
                        Text="No notifications found in your per-user cache."
                        Visibility="{x:Bind ViewModel.EmptyNotificationsVisibility, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                        AutomationProperties.Name="My Notifications List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NotificationItemViewModel">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="14"
                                    CornerRadius="6"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    AutomationProperties.Name="{x:Bind AccessibilityName}">
                                    <Grid ColumnSpacing="14" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border
                                                    Padding="6,2"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="{x:Bind PriorityGlyph}" FontSize="12" />
                                                        <TextBlock
                                                            Text="{x:Bind PriorityLabel}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Padding="6,2"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="12" />
                                                        <TextBlock
                                                            Text="{x:Bind TypeLabel}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border
                                                    Padding="6,2"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <TextBlock
                                                        Text="{x:Bind StatusBadgeText}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                                </Border>

                                                <Border
                                                    Padding="6,2"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind PendingSyncVisibility}"
                                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                                    <TextBlock
                                                        Text="{x:Bind PendingSyncText}"
                                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                                        FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Text="{x:Bind SafeSummary}"
                                                TextWrapping="Wrap" />

                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                <TextBlock
                                                    Text="{x:Bind CreatedLocalText}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind DueLocalText}"
                                                    Visibility="{x:Bind DueVisibility}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <TextBlock
                                                Text="{x:Bind LifecycleSummaryText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button
                                                Content="Mark Read"
                                                Tag="{x:Bind}"
                                                IsEnabled="{x:Bind CanMarkRead}"
                                                Click="MarkReadButton_Click"
                                                AutomationProperties.Name="Mark Read" />
                                            <Button
                                                Content="Acknowledge"
                                                Tag="{x:Bind}"
                                                IsEnabled="{x:Bind CanAcknowledge}"
                                                Click="AcknowledgeButton_Click"
                                                AutomationProperties.Name="Acknowledge" />
                                            <Button
                                                Content="Complete"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind CompleteVisibility}"
                                                IsEnabled="{x:Bind CanComplete}"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Click="CompleteButton_Click"
                                                AutomationProperties.Name="Complete" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border
                Visibility="{x:Bind ViewModel.PublishSectionVisibility, Mode=OneWay}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Sent Notifications (Supervisor / Admin Summary)"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <TextBlock
                        Text="No published notifications yet."
                        Visibility="{x:Bind ViewModel.EmptyPublishedVisibility, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.PublishedNotifications, Mode=OneWay}"
                        AutomationProperties.Name="Sent Notifications Summary Table">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdminNotificationSummaryItemViewModel">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    CornerRadius="6"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    AutomationProperties.Name="{x:Bind AccessibilityName}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Text="{x:Bind PriorityLabel}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind TypeLabel}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind StatusText}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    FontWeight="SemiBold" />
                                            </StackPanel>

                                            <TextBlock
                                                Text="{x:Bind DeliveryCountsText}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                TextWrapping="Wrap" />

                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock
                                                    Text="{x:Bind TargetSummaryText}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind CreatedLocalText}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Text="{x:Bind DueLocalText}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Content="Cancel"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind CancelVisibility}"
                                            IsEnabled="{x:Bind CanCancel}"
                                            VerticalAlignment="Center"
                                            Click="CancelNotificationButton_Click"
                                            AutomationProperties.Name="Cancel Notification" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
