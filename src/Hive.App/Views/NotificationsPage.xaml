<Page
    x:Class="Hive.App.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" Padding="4" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock
            Text="Notifications"
            Style="{ThemeResource TitleTextBlockStyle}"
            AutomationProperties.Name="Notifications Heading" />
        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Scheduled for Phase P4 (Notifications)"
            Message="Durable cursor-synced notifications, separate read/acknowledge/complete tracking, and toast/widget health status will appear here." />
    </StackPanel>
</Page>
