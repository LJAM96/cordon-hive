<Window
    x:Class="Hive.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cordon Hive">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0"
            VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                <TextBlock
                    Text="Cordon Hive"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="LAN Console (Unelevated)"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="RootNavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            AutomationProperties.Name="Primary Navigation"
            SelectionChanged="RootNavigationView_SelectionChanged">
            <Grid Padding="20,12,20,20" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <InfoBar
                        x:Name="ConnectivityInfoBar"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=TwoWay}"
                        Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                        Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
                        AutomationProperties.Name="Server Connectivity Status Banner">
                        <InfoBar.ActionButton>
                            <Button
                                x:Name="BannerActionButton"
                                Content="{x:Bind ViewModel.BannerActionLabel, Mode=OneWay}"
                                Click="BannerActionButton_Click"
                                AutomationProperties.Name="{x:Bind ViewModel.BannerActionLabel, Mode=OneWay}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar
                        x:Name="MustChangePasswordInfoBar"
                        Severity="Warning"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.MustChangePasswordBanner, Mode=OneWay}"
                        Title="Password Change Required"
                        Message="You signed in with a temporary password. Update your password before continuing normal operations."
                        AutomationProperties.Name="Password Change Required Banner">
                        <InfoBar.ActionButton>
                            <Button
                                Content="Change Password"
                                Click="ChangePasswordBannerButton_Click"
                                AutomationProperties.Name="Change Password" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    AutomationProperties.Name="Page Content Frame" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
